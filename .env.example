# Docelowa domena produkcyjna (bez ukośnika na końcu).
# Do czasu przydzielenia docelowej domeny zostaw wartość poniżej – zostanie
# podmieniona jednorazowo we wszystkich miejscach (metadane, sitemap, JSON-LD,
# adres kontaktowy w stopce), bo cała aplikacja czyta tylko tę zmienną.
NEXT_PUBLIC_SITE_URL=https://twoja-domena-tutaj.pl

# Opcjonalne identyfikatory pomiarowe – jeśli puste, żaden skrypt pomiarowy
# się nie ładuje i baner zgody nie pokazuje przełącznika statystyk.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
